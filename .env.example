# Корневой .env для docker-compose.
# Скопируйте в .env: cp .env.example .env
# Используется ТОЛЬКО для переменных docker-compose (подстановка ${VAR:-default}).
# Для локального запуска backend без Docker используйте backend/.env.

# PostgreSQL
POSTGRES_USER=steply_user
POSTGRES_PASSWORD=steply_password
POSTGRES_DB=steply_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://steply_user:steply_password@postgres:5432/steply_db

# Backend
# Local defaults below are for development/demo only.
# Outside local environment the backend requires:
# ENVIRONMENT=production (or staging)
# AUTO_INIT_DB=false
# SECRET_KEY=<long-random-secret>
# BACKEND_CORS_ORIGINS=https://your-frontend.example.com
# BACKEND_CORS_ORIGIN_REGEX=
APP_NAME=Steply
ENVIRONMENT=local
AUTO_INIT_DB=true
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_PORT=8000
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=*
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default regex keeps dev API available to private LAN frontend origins.
# Leave it empty outside local environment and list exact origins above.
BACKEND_CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10(?:\.[0-9]+)+|192\.168(?:\.[0-9]+)+|172\.(?:1[6-9]|2[0-9]|3[01])(?:\.[0-9]+)+)(?::[0-9]+)?$

# Optional AI recommendations through BotHub. Keep disabled until a key is configured.
AI_ENABLED=false
AI_PROVIDER=bothub
AI_REQUEST_TIMEOUT_SECONDS=12
AI_DAILY_RECOMMENDATION_LIMIT=5
BOTHUB_API_KEY=
BOTHUB_BASE_URL=https://openai.bothub.chat/v1
BOTHUB_MODEL=gpt-5.4-mini

# Frontend
FRONTEND_PORT=5173
# make start tries to detect this automatically; set it to override detection.
STEPLY_LAN_HOST=
# Optional full URL override for QR. On hosting leave empty to use the current domain.
# Example for local demo: http://192.168.1.50:5173
VITE_PUBLIC_APP_URL=
# Browser uses the page hostname with this API port by default.
VITE_API_PORT=8000
# Optional full API override. On hosting set it if backend is on another domain.
# Example: https://api.example.com/api
VITE_API_URL=

# Production compose / reverse proxy
# Use docker-compose.prod.yml only with real TLS files and explicit public domain.
SERVER_NAME=steply.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=./deploy/nginx/certs/fullchain.pem
TLS_KEY_PATH=./deploy/nginx/certs/privkey.pem
