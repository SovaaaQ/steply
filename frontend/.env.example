# Browser uses the page hostname with this API port by default.
VITE_API_PORT=8000
# Optional QR override. Local Vite detects a private LAN IPv4 when this is empty.
VITE_PUBLIC_APP_URL=
# Optional host override for the auto-built QR URL, without protocol or port.
STEPLY_LAN_HOST=
# Optional full API override. Keep empty for localhost and phone auto-routing.
VITE_API_URL=
